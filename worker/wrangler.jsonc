{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "qv-work-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "vars": {
    "ALLOWED_ORIGIN": "https://utarasolar.github.io"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": {
    "crons": ["17 */6 * * *"]
  }
}
